-usr/lib/${DEB_HOST_MULTIARCH}/wireshark/plugins/*/epan/libvirt.so
diff --git a/debian/libvirt-wireshark.links b/debian/libvirt-wireshark.links
deleted file mode 100644
index 958a13990..000000000
--- a/debian/libvirt-wireshark.links
+++ /dev/null
@@ -1 +0,0 @@
-usr/share/doc/libvirt-common usr/share/doc/libvirt-wireshark
diff --git a/debian/libvirt-wireshark.maintscript b/debian/libvirt-wireshark.maintscript
deleted file mode 100644
index ba814e478..000000000
--- a/debian/libvirt-wireshark.maintscript
+++ /dev/null
